{
  "name": "veda-ai-assessment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); try{fs.rmSync('.next',{recursive:true,force:true});}catch(e){}\" && next dev",
    "build": "node -e \"const fs=require('fs'); try{fs.rmSync('.next',{recursive:true,force:true,maxRetries:3,retryDelay:200});}catch(e){console.warn('Unable to clear .next:',e.message)}\" && next build",
    "start": "next start",
    "lint": "next lint",
    "test:ocr": "tsx scratch/test_accuracy_fixtures.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scratch/validate.ts",
    "benchmark:ocr": "tsx scratch/benchmark_ocr.ts",
    "validate:ocr": "tsx scratch/validate_ocr.ts",
    "clean": "node -e \"const fs=require('fs'); ['node_modules/.cache','.next'].forEach(p => { try{fs.rmSync(p,{recursive:true,force:true,maxRetries:3,retryDelay:200});}catch(e){console.warn('Unable to clean '+p+': '+e.message)} });\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@napi-rs/canvas": "^0.1.67",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.5",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
